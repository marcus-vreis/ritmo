{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ritmo",
  "version": "0.1.0",
  "identifier": "io.github.marcusvreis.ritmo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ritmo",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "mini",
        "title": "ritmo · agora",
        "url": "mini.html",
        "width": 340,
        "height": 132,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
